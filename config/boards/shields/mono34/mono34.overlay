/*
 * mono34 - 34 key unibody, Sweep-style layout, Pro Micro interconnect.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "mono34-layouts.dtsi"

&mono34_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &mono34_layout;
        // NOTE: deliberately no `zmk,matrix-transform` here. The transform is
        // attached to the physical layout above instead, which is the current
        // ZMK convention for shields that declare a physical layout.
    };

    /*
     * 34 keys on a 4x10 matrix. The three alpha rows use all ten columns;
     * the four thumb keys hang off row 3 under columns 3..6.
     *
     *  SW1  SW2  SW3  SW4  SW5    SW6  SW7  SW8  SW9  SW10
     *  SW11 SW12 SW13 SW14 SW15   SW16 SW17 SW18 SW19 SW20
     *  SW21 SW22 SW23 SW24 SW25   SW26 SW27 SW28 SW29 SW30
     *                 SW31 SW32   SW33 SW34
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                    RC(3,3) RC(3,4)   RC(3,5) RC(3,6)
        >;
    };

    /*
     * col2row: the columns are driven (outputs) and the rows are read
     * (inputs with pull-downs). Diode cathodes face the row lines.
     *
     * If your PCB has the diodes the other way round, change this to
     * "row2col" and swap the GPIO flags between the two lists.
     *
     * Pins are addressed as raw RP2040 GPIOs (&gpio0 N == GPN on the
     * silkscreen) rather than through the &pro_micro nexus. The nexus uses
     * Arduino Pro Micro pad numbers, which do NOT line up with GP numbers
     * above D9 (D10=GP21, D14=GP20, D15=GP22, D16=GP23, A0..A3=GP26..GP29)
     * and which swap D0/D1; it also has no entry at all for GP13. Using
     * &gpio0 keeps this file readable straight off the board.
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&gpio0 0 GPIO_ACTIVE_HIGH>
            , <&gpio0 1 GPIO_ACTIVE_HIGH>
            , <&gpio0 2 GPIO_ACTIVE_HIGH>
            , <&gpio0 3 GPIO_ACTIVE_HIGH>
            , <&gpio0 4 GPIO_ACTIVE_HIGH>
            , <&gpio0 5 GPIO_ACTIVE_HIGH>
            , <&gpio0 6 GPIO_ACTIVE_HIGH>
            , <&gpio0 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 8 GPIO_ACTIVE_HIGH>
            , <&gpio0 9 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
