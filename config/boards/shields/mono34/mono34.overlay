/*
 * mono34 - 34 key unibody, Sweep-style layout, Pro Micro interconnect.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "mono34-layouts.dtsi"

&mono34_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &mono34_layout;
        // NOTE: deliberately no `zmk,matrix-transform` here. The transform is
        // attached to the physical layout above instead, which is what ZMK
        // Studio requires.
    };

    /*
     * 34 keys on a 4x10 matrix. The three alpha rows use all ten columns;
     * the four thumb keys hang off row 3 under columns 3..6.
     *
     *  SW1  SW2  SW3  SW4  SW5    SW6  SW7  SW8  SW9  SW10
     *  SW11 SW12 SW13 SW14 SW15   SW16 SW17 SW18 SW19 SW20
     *  SW21 SW22 SW23 SW24 SW25   SW26 SW27 SW28 SW29 SW30
     *                 SW31 SW32   SW33 SW34
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                    RC(3,3) RC(3,4)   RC(3,5) RC(3,6)
        >;
    };

    /*
     * col2row: the columns are driven (outputs) and the rows are read
     * (inputs with pull-downs). Diode cathodes face the row lines.
     *
     * If your PCB has the diodes the other way round, change this to
     * "row2col" and swap the GPIO flags between the two lists.
     *
     * Pin numbers are Pro Micro pad numbers (D0..D21), not RP2040 GPIO
     * numbers, so this shield works on any pro_micro-compatible board.
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&pro_micro 0 GPIO_ACTIVE_HIGH>
            , <&pro_micro 1 GPIO_ACTIVE_HIGH>
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>
            , <&pro_micro 3 GPIO_ACTIVE_HIGH>
            , <&pro_micro 4 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
