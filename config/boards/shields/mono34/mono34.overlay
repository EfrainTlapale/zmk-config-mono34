/*
 * mono34 - 34 key unibody, Sweep-style layout, Waveshare RP2040-Zero.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "mono34-layouts.dtsi"

// TPS43 (Azoteq IQS572) trackpad on I2C1 (GP14/GP15) + GP26/GP27. Comment this
// line out to build firmware for a bare mono34 with no trackpad attached.
#include "mono34-trackpad.dtsi"

&mono34_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &mono34_layout;
        // NOTE: deliberately no `zmk,matrix-transform` here. The transform is
        // attached to the physical layout above instead, which is the current
        // ZMK convention for shields that declare a physical layout.
    };

    /*
     * 34 keys on a 4x10 matrix. The three alpha rows use all ten columns;
     * the four thumb keys hang off row 3 under columns 3..6.
     *
     *  SW1  SW2  SW3  SW4  SW5    SW6  SW7  SW8  SW9  SW10
     *  SW11 SW12 SW13 SW14 SW15   SW16 SW17 SW18 SW19 SW20
     *  SW21 SW22 SW23 SW24 SW25   SW26 SW27 SW28 SW29 SW30
     *                 SW31 SW32   SW33 SW34
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                    RC(3,3) RC(3,4)   RC(3,5) RC(3,6)
        >;
    };

    /*
     * col2row: the columns are driven (outputs) and the rows are read
     * (inputs with pull-downs). Diode cathodes face the row lines.
     *
     * If your PCB has the diodes the other way round, change this to
     * "row2col" and swap the GPIO flags between the two lists.
     *
     * Pins go through the board's &zero_d nexus, which maps 1:1 onto the
     * RP2040 GPIOs (&zero_d N == GPN on the silkscreen). Every pin used here
     * is on the castellated edge of the RP2040-Zero: GP0..GP15 and GP26..GP29
     * are edge pins, while GP17..GP25 are solder pads on the back and GP16 is
     * wired to the onboard WS2812 (left out of the board devicetree, but still
     * on that net physically -- avoid it for matrix lines).
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&zero_d 9 GPIO_ACTIVE_HIGH>
            , <&zero_d 8 GPIO_ACTIVE_HIGH>
            , <&zero_d 7 GPIO_ACTIVE_HIGH>
            , <&zero_d 6 GPIO_ACTIVE_HIGH>
            , <&zero_d 5 GPIO_ACTIVE_HIGH>
            , <&zero_d 4 GPIO_ACTIVE_HIGH>
            , <&zero_d 3 GPIO_ACTIVE_HIGH>
            , <&zero_d 2 GPIO_ACTIVE_HIGH>
            , <&zero_d 1 GPIO_ACTIVE_HIGH>
            , <&zero_d 0 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&zero_d 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&zero_d 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&zero_d 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&zero_d 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
