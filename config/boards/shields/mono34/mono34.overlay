/*
 * mono34 - 34 key wireless unibody, Sweep-style layout, single nice!nano v2.
 *
 * Matches the PCB `mono34_unibody_inserts` in ergogen/config.yaml: the
 * nice!nano sits on the back of the PCB, components facing the base, and the
 * matrix nets there are named after the Pro Micro pins (P16 == &pro_micro 16).
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "mono34-layouts.dtsi"

&mono34_layout {
    transform = <&default_transform>;
};

/*
 * D16 (P0.10) drives the left pinky column, and D16/D10 are the nRF52840's
 * NFC pins. ZMK's nice_nano board does not hand them over as GPIOs, so the
 * shield does (since Zephyr 4.1 this is a UICR devicetree property; it
 * replaced CONFIG_NFCT_PINS_AS_GPIOS).
 */
&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &mono34_layout;
        // NOTE: deliberately no `zmk,matrix-transform` here. The transform is
        // attached to the physical layout above instead, which is the current
        // ZMK convention for shields that declare a physical layout.
    };

    /*
     * 34 keys on a 4x10 matrix. The three alpha rows use all ten columns;
     * the four thumb keys are on row 3 and share the index and inner
     * columns of each half (columns 3..6).
     *
     *  SW1  SW2  SW3  SW4  SW5    SW6  SW7  SW8  SW9  SW10
     *  SW11 SW12 SW13 SW14 SW15   SW16 SW17 SW18 SW19 SW20
     *  SW21 SW22 SW23 SW24 SW25   SW26 SW27 SW28 SW29 SW30
     *                 SW31 SW32   SW33 SW34
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                                    RC(3,3) RC(3,4)   RC(3,5) RC(3,6)
        >;
    };

    /*
     * col2row: the columns are driven (outputs) and the rows are read
     * (inputs with pull-downs). On the PCB every diode's cathode (pad 1) is
     * on the row net.
     *
     * Columns, physically left to right (ergogen column_net):
     *   left  pinky P16, ring P14, middle P15, index P18, inner P19
     *   right inner P5,  index P6, middle P7,  ring P8,   pinky P9
     * Rows: top P21, home P20, bottom P0, thumbs P4.
     * Thumbs, left to right: left tucky (index col, P18), left reachy (inner
     * col, P19), right reachy (P5), right tucky (P6) -> RC(3,3)..RC(3,6).
     *
     * Free for later: D1, D2, D3 (a nice!view), D10, and the nice!nano's
     * extra pins P1.01, P1.02, P1.07 (wired to pads on the PCB).
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&pro_micro 16 GPIO_ACTIVE_HIGH>
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>
            , <&pro_micro 5 GPIO_ACTIVE_HIGH>
            , <&pro_micro 6 GPIO_ACTIVE_HIGH>
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>
            ;

        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
